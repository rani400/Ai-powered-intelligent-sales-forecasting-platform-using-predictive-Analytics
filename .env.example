# APPLICATION
APP_NAME=SalesGenie AI

# DATABASE
# SQLite is used by default.
# DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST/salesgenie?sslmode=require

# POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# CORS CONFIGURATION
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# GEMINI AI CONFIGURATION
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_API_URL=

# LEAD SCORING AND ML
MODEL_PATH=artifacts/conversion_model.joblib
METRICS_PATH=artifacts/model_metrics.json

# CSV IMPORT
MAX_CSV_BYTES=5000000

# Keep disabled unless testing live CRM writes.
CRM_LIVE_SYNC_ENABLED=false

# Secret required for live CRM synchronization.
CRM_ADMIN_KEY=

# SALESFORCE CRM
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_INSTANCE_URL=
SALESFORCE_API_VERSION=v60.0

# HUBSPOT CRM
HUBSPOT_ACCESS_TOKEN=

