# SalesGenie AI - environment configuration template
# Copy to `.env` and fill in real values. Never commit the filled `.env`.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production (PostgreSQL):
#   DATABASE_URL=postgresql+psycopg2://salesgenie:<password>@localhost:5432/salesgenie
# Local development / automated tests (no server required):
DATABASE_URL=sqlite:///./salesgenie.db

# Set to "true" when using SQLite so that foreign keys are actually enforced.
SQLITE_FOREIGN_KEYS=true

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
APP_NAME=SalesGenie AI
APP_VERSION=1.0.0
API_PREFIX=/api
DEBUG=false

# ---------------------------------------------------------------------------
# CORS - comma separated list of allowed origins
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ---------------------------------------------------------------------------
# LLM provider for AI outreach generation
# ---------------------------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint works.
# Leave LLM_API_KEY empty to run the service in clearly-labelled mock mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
