# Copy to .env for local use. DO NOT commit .env.
APP_NAME=SalesGenie AI
# SQLite default (leave DATABASE_URL unset) or set a PostgreSQL DSN:
# DATABASE_URL=postgresql+psycopg://salesgenie:YOUR_LOCAL_PASSWORD@localhost:5432/salesgenie
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_API_URL=https://api.openai.com/v1/chat/completions
# Required only for docker compose PostgreSQL:
# POSTGRES_PASSWORD=SET_YOUR_OWN_PASSWORD
